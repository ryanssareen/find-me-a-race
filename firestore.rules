rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Race data is public, read-only to clients. All writes happen through the
    // Firebase Admin SDK (server-side data layer + seed scripts), which bypasses
    // these rules entirely, so every client-side write is denied.
    match /races/{raceId} {
      allow read: if true;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
